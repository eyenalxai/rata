{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "rata-cli",
  "version": "0.4.0",
  "description": "Linear issue tracking for agent workflows: triage, tickets and wayfinding from the terminal.",
  "license": "MIT",
  "bin": {
    "rata": "./src/main.ts"
  },
  "type": "module",
  "scripts": {
    "rata": "bun run src/main.ts",
    "db:generate": "drizzle-kit generate",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "tsc": "tsc --noEmit",
    "test": "bun test --only-failures",
    "check": "bun run format:check && bun run lint && bun run tsc && bun run test",
    "prepare": "effect-tsgo patch --no-typescript --oxlint"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0",
    "@effect/sql-sqlite-bun": "4.0.0",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.47.2",
    "@types/bun": "1.4.2",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
